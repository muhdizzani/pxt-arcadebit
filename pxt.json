{
    "name": "hw---arcadebit",
    "description": "ARCADE:BIT - A micro:bit Display Shield for MakeCode Arcade.",
    "dependencies": {
        "core---nrf52": "*",
        "screen---st7735": "*",
        "mixer---nrf52": "*",
        "game": "*"
    },
    "files": [
        "config.ts",
        "basepins.d.ts",
        "device.d.ts"
    ],
    "public": true,
    "targetVersions": {
        "target": "4.1.25",
        "pxt": "12.2.34",
        "targetId": "arcade"
    },
    "supportedTargets": [
        "arcade"
    ],
    "preferredEditor": "tsprj",
    "card": {
        "name": "Cytron ARCADE:BIT",
        "description": "A micro:bit Display Shield for MakeCode Arcade.",
        "learnMoreUrl": "https://www.cytron.io",
        "cardType": "hw",
        "imageUrl": "/static/hardware/mrt-gamemaker-kit.png"
    },
    "compileServiceVariant": "nrf52833",
    "cppDependencies": {
        "accelerometer": "file:../accelerometer"
    },
    "skipLocalization": true,
    "yotta": {
        "optionalConfig": {
            "DEVICE_JACDAC_DEBUG": 1
        },
        "config": {
            "DEVICE_USB": 0,
            "DEVICE_WEBUSB": 0,
            "DEVICE_BLE": 0,
            "ARCADE_MBIT_CODAL": 1,
            "MICROBIT_CODAL": 0
        }
    },
    "dalDTS": {
        "corePackage": "../core---nrf52"
    }
}
